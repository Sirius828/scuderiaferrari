# 语义分割节点配置文件
# 包含岔路口检测与外圈锁定参数

semantic_segmentation_node:
  ros__parameters:
    # ========================================
    # 基础参数
    # ========================================
    shm_name: "shm_ar_video"
    model_dir: "model"
    tpes: 3
    blend_alpha: -1.0  # -1表示只显示分割结果，不混合原图
    show_window: true
    show_debug_window: false
    enable_perf_stats: false
    
    # 图像预处理参数
    enable_flip: true
    flip_code: 0  # 0=垂直翻转, 1=水平翻转, -1=两者
    input_format: "RGB"
    model_input_format: "RGB"
    
    # Mask发布参数
    publish_mask: false  # false表示发布Float32 offset而非Image mask
    publish_mask_every_n: 1
    
    # ========================================
    # ⭐ 岔路口检测与外圈锁定参数
    # ========================================
    
    # 总开关
    enable_intersection_logic: true
    
    # 外圈方向配置
    outer_side: "left"  # "left" 或 "right"，取决于赛道布局
    
    # --- 远处检测ROI (用于提前发现岔路口) ---
    # ⭐ 注意：地平线在图像上半部分，Far ROI应该在上半部分
    # ROI范围: y = 0.10h ~ 0.45h (图像高度的10%~45%，地平线附近)
    far_roi_y0_ratio: 0.35  # 远处ROI起始y比例（靠近顶部）
    far_roi_y1_ratio: 0.75  # 远处ROI结束y比例（中线之前）
    far_width_threshold: 0.55  # 远处岔路宽度阈值 (道路宽度/图像宽度 > 0.55判定为岔路)
    
    # --- 近处检测ROI (用于判断岔路是否进入控制区域) ---
    # ⭐ 注意：赛道在图像下半部分，Near ROI应该在下半部分
    # ROI范围: y = 0.50h ~ 0.95h (图像高度的50%~95%，赛道区域)
    near_roi_y0_ratio: 0.85  # 近处ROI起始y比例（从中线开始）
    near_roi_y1_ratio: 0.95  # 近处ROI结束y比例（接近底部）
    near_width_threshold: 0.8  # 近处岔路宽度阈值 (道路宽度/图像宽度 > 0.55判定为岔路)
    
    # --- 退出锁定条件 ---
    exit_width_threshold: 0.45  # 退出锁定的宽度阈值 (道路宽度/图像宽度 < 0.45认为回到单路)
    exit_confirm_frames: 5  # 连续N帧满足退出条件才确认退出
    max_lock_time: 2.0  # 最大锁定时间(秒)，超时强制退出
    
    # --- 检测灵敏度 ---
    min_road_pixels: 300  # 最小道路像素数，低于此值认为检测无效


# ========================================
# 参数调优指南
# ========================================
#
# 1. 如果车应该走外圈但走了内圈：
#    → 修改 outer_side: "left" ↔ "right"
#
# 2. 如果过早进入 LOCK_OUTER_BRANCH 状态：
#    → 增大 near_width_threshold (例如 0.60 → 0.70)
#    → 或增大 near_roi_y0_ratio (例如 0.50 → 0.60)
#
# 3. 如果检测不到岔路：
#    → 减小 far_width_threshold (例如 0.65 → 0.55)
#    → 或扩大 far_roi 范围 (例如 0.20~0.60 → 0.15~0.65)
#
# 4. 如果锁定时间太长，过了岔路口还在屏蔽：
#    → 减小 max_lock_time (例如 2.0 → 1.5)
#    → 或增大 exit_width_threshold (例如 0.45 → 0.50)
#
# 5. 如果频繁在NORMAL和LOCK之间切换：
#    → 增大 exit_confirm_frames (例如 5 → 8)
#
# 6. 如果检测不稳定（偶尔误判）：
#    → 增大 min_road_pixels (例如 300 → 500)
#
# ========================================
# ROI可视化说明
# ========================================
#
# 图像坐标系 (假设图像高度 h=480，地平线在上半部分):
# 
# y=0   ┌─────────────────────┐
#       │                     │
# y=48  │  (far_roi starts)   │ ← far_roi_y0_ratio=0.10
#       │                     │
#       │   Far ROI           │ ⭐ 远处检测区（地平线附近）
#       │   (提前发现岔路)     │
#       │                     │
# y=216 ├─────────────────────┤ ← far_roi_y1_ratio=0.45
#       │                     │
# y=240 ├─────────────────────┤ ← 图像中线 (h/2)
#       │                     │
# y=240 ├─────────────────────┤ ← near_roi_y0_ratio=0.50
#       │                     │
#       │   Near ROI          │ ⭐ 近处控制区（赛道区域）
#       │   (影响舵机转向)     │
#       │                     │
# y=456 ├─────────────────────┤ ← near_roi_y1_ratio=0.95
#       │                     │
#       │   车前近距离         │
#       │                     │
# y=480 └─────────────────────┘
#
# 注意：
# - Far ROI 在上半部分（地平线附近），用于提前检测岔路
# - Near ROI 在下半部分（赛道区域），用于计算offset控制舵机
# - 两个ROI不重叠，分别对应远处和近处
